{
  "$schema": "./web/node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "browser": true
  },
  "overrides": [
    {
      "files": ["**/*.svelte", "**/*.svelte.{js,ts}"],
      "env": {
        "svelte": true
      }
    }
  ]
}
